{
  "name": "zumbi-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Zumbi Bot - A revolução dos robôs no apocalipse zumbi. Beat 'em up 2.5D no navegador.",
  "type": "module",
  "license": "CC0-1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/three": "0.186.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
